Options -MultiViews
RewriteEngine On
RewriteBase /
ErrorDocument 404 /404.php

# Canonicalize www to the apex domain (avoids grovixo.com and www.grovixo.com
# being crawled/indexed as separate duplicate-content sites)
RewriteCond %{HTTP_HOST} ^www\.grovixo\.com$ [NC]
RewriteRule ^(.*)$ https://grovixo.com/$1 [R=301,L]

# If the request is for a valid directory, let it pass
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Force redirect from .php to extensionless
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Append .php internally if the corresponding file exists
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.*?)/?$ $1.php [L]
