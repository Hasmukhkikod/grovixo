# Copy to .env and fill in real values. .env is gitignored and must never be committed.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Hostinger Titan Mail defaults: smtp.hostinger.com, port 465 + ssl (or 587 + tls)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Grovixo Agency
